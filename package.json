{
  "name": "@getchat-dev/web-button",
  "version": "0.2.0",
  "type": "module",
  "homepage": "https://github.com/getchat-dev/web-button?tab=readme-ov-file#terms",
  "bugs": "https://github.com/getchat-dev/web-button/issues",
  "scripts": {
    "dev": "vite",
    "build": "vite build --emptyOutDir",
    "build:dev": "vite build --emptyOutDir --watch --mode development",
    "build-browser": "vite build --emptyOutDir --config vite.browser.config.js",
    "build-browser:dev": "vite build --emptyOutDir --watch --mode development --config vite.browser.config.js",
    "preview": "vite preview",
    "prepack": "vite build --emptyOutDir && vite build --config vite.browser.config.js"
  },
  "browser": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getchat-dev/web-button.git"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.2",
    "lightningcss": "^1.29.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  },
  "keywords": [
    "getchat",
    "sdk",
    "chat",
    "messaging",
    "conversation",
    "chatbots",
    "realtime"
  ],
  "files": [
    "dist",
    "src/*.d.ts",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "author": "Evgeniy Tyurin",
  "license": "MIT"
}
