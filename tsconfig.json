{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "emitDeclarationOnly": false,
    "target": "ES2022",
    "types": [
      "vite/client"
    ],
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "es2024",
      "DOM",
      "DOM.Iterable",
      "webworker"
    ],
    "skipLibCheck": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,

    "allowJs": true,
    "checkJs": true,
    "noEmit": false,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.ts",
  ]
}